# Include the README
include README.md

# setup.py reads the compile list from this file, so an sdist without it cannot build
# (generated by tools/gen_sources.py, revision plan step 17)
include sources.json

# Everything the C++ build needs. setuptools ships the .cpp files of an Extension automatically
# but NOT its headers, so before this the sdist carried all 133 sources and none of the 432
# headers and could not be compiled by anyone (revision plan step 24a).
recursive-include src *.h
recursive-include include *

# Windows and macOS link against these; on Linux glfw comes from the system
recursive-include libs *

# The parts of src/pythonGenerator/ the BUILD needs - not the generators themselves.
#
# exudynVersion.py is exec()ed at import time, so an sdist without it fails immediately.
# autoGenerateDocstrings.py is loaded by setup.py's load_converter() and is NOT optional: it
# raises FileNotFoundError('Converter not found at ...') and the build stops.
# createStubFiles.py and its five generated .pyi inputs produce the shipped __init__.pyi; that
# step is allowed to fail, but without the inputs every sdist install ships an unmerged stub.
include src/pythonGenerator/exudynVersion.py
include src/pythonGenerator/autoGenerateDocstrings.py
include src/pythonGenerator/createStubFiles.py
include src/pythonGenerator/stubHeader.pyi
recursive-include src/pythonGenerator/generated *.pyi

# build options; setup.py falls back to defaults when it is missing, but then a source build
# silently differs from the one the maintainer runs
include setupPyConfig.json

# Both of these were unreachable before the flatten, because they sat ABOVE the sdist root and
# setuptools cannot follow a '../'. Step 25 moved the packaging root up to the repository root,
# so they are now ordinary includes (revision plan steps 24, 25, 81).
#
# version.txt is the single version source. Without it exudynVersion.py raises, and before that
# rewrite the version silently degraded to the string 'unknown' - which is exactly why the sdist
# on pypi.org could not be built (#2383).
include version.txt
include LICENSE.txt
