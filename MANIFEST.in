# Include the README
include README.md

# setup.py reads the compile list from this file, so an sdist without it cannot build
# (generated by tools/gen_sources.py, revision2026 step R2.4)
include sources.json

# Everything the C++ build needs. setuptools ships the .cpp files of an Extension automatically
# but NOT its headers, so before this the sdist carried all 133 sources and none of the 432
# headers and could not be compiled by anyone (revision2026 step R2.11.1).
recursive-include src *.h
recursive-include include *

# Windows and macOS link against these; on Linux glfw comes from the system
recursive-include libs *

# The parts of tools/generators/ the BUILD needs - not the generators themselves.
#
# exudynVersion.py is exec()ed at import time, so an sdist without it fails immediately; it
# lives with the other build-time helpers since revision2026b step RG10.4 (#2618).
# createStubFiles.py and its five generated .pyi inputs produce the shipped __init__.pyi; that
# step is allowed to fail, but without the inputs every sdist install ships an unmerged stub.
include tools/generators/exudynVersion.py
include tools/generators/createStubFiles.py
include tools/generators/generatorPaths.py
include tools/generators/stubHeader.pyi
recursive-include tools/generators/generated *.pyi

# Both of these were unreachable before the flatten, because they sat ABOVE the sdist root and
# setuptools cannot follow a '../'. revision2026 step R3.1 moved the packaging root up to the repository root,
# so they are now ordinary includes (revision2026 steps R2.11, R3.1, R2.13).
#
# version.txt is the single version source. Without it exudynVersion.py raises, and before that
# rewrite the version silently degraded to the string 'unknown' - which is exactly why the sdist
# on pypi.org could not be built (#2383).
include version.txt
include LICENSE.txt
