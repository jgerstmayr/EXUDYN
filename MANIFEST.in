# Include the README
include README.md

# setup.py reads the compile list from this file, so an sdist without it cannot build
# (generated by tools/gen_sources.py, revision plan step 17)
include sources.json

# Everything the C++ build needs. setuptools ships the .cpp files of an Extension automatically
# but NOT its headers, so before this the sdist carried all 133 sources and none of the 432
# headers and could not be compiled by anyone (revision plan step 24a).
recursive-include src *.h
recursive-include include *

# Windows and macOS link against these; on Linux glfw comes from the system
recursive-include libs *

# setup.py exec()s exudynVersion.py at import time, so an sdist without it fails immediately;
# createStubFiles.py is optional (its failure is caught) but produces the shipped __init__.pyi
include src/pythonGenerator/exudynVersion.py
include src/pythonGenerator/createStubFiles.py

# build options; setup.py falls back to defaults when it is missing, but then a source build
# silently differs from the one the maintainer runs
include setupPyConfig.json

# The license file is NOT included: it lives at the repository root, one level above the sdist
# root, and setuptools cannot reach outside that - 'include ../LICENSE.txt' was a silent no-op.
# Revision plan step 25 moves the packaging root up, which makes the '../' unnecessary; the
# include comes back then.
