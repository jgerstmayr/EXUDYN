# Exudyn .gitignore
#
# Deliberately NOT ignored, because they are versioned on purpose:
#   python/logs/performance/  per-release performance records
#   python/logs/testmodels/   per-release test suite records (retention policy: plan D7)
#   python/logs/examples/     per-release example-run records
#   msvc/cppsrc.vcxproj           the live VS project and de-facto source list
# Add new entries with a comment saying what produces the file.

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Visual Studio
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps
*.ilk
*.pdb
*.idb
*.tlog
*.iobj
*.ipdb
*.log
*.lastbuildstate
*.obj
*.exp
*.lib

# build configuration output directories (VS puts these next to the project)
x64/
Win32/
Debug/
Release/
ReleaseP*/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Python / setuptools build output
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
__pycache__/
*.py[cod]
*.so
*.pyd
build/
*.egg-info/
*.egg
.eggs/
wheelhouse/

# build output; untracked 2026-09-09 (revision2026 step R0.1)
dist/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Generator scratch output
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# intermediate data formerly written by the generators (no longer written since revision2026 step R4.3)
tools/generators/generated/*.npy
# generator scratch file
test.txt

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Test suite output (written into the tree by runTestSuite.py)
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
python/TestModels/solution/
python/PerformanceModels/solution/
python/Examples/solution/
# the default solution file of the simulation settings is 'coordinatesSolution', with no directory, so
# a model run from any folder writes it there - in text or in binary form
coordinatesSolution.txt
coordinatesSolution.sol

# artefacts of the netgen tests' load/save round trip (netgenTestMesh2*), NOT the committed mesh:
# netgenTestMesh.npz is tracked and holds the reference solution of NGsolveCMStest (#2469). It used
# to be netgenTestMesh.pkl, which was tracked while matching the ignore pattern below - so a file
# the test silently overwrote was also a file git did not mention unless it was already tracked.
python/TestModels/testData/netgenTestMesh2*.hdf5
python/TestModels/testData/netgenTestMesh2*.pkl
python/TestModels/testData/netgenTestMesh2*.npz

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# LaTeX intermediates (theDoc.pdf itself is committed for now; see revision2026 step R7.3)
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
*.aux
*.toc
*.out
*.synctex.gz
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.idx
*.ind
*.ilg

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Sphinx
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
_build/
docs/_build/
.doctrees/
#"exudev docs --pdf": the .tex and the LaTeX run (revision2026b step RG3.3). NOTE .gitignore has
#no inline comments - a comment after a pattern is part of the pattern
_buildpdf/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Editors and OS
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
.idea/
.vscode/
.spyproject/
.ipynb_checkpoints/
Thumbs.db
desktop.ini
.DS_Store

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Regenerated on every issueTracker write; the same content is tracked as
# docs/RST/trackerlog.rst and docs/theDoc/trackerlog.tex
tools/issueTracker/trackerlog.html

# diverted test/performance logs: written when the release-named target already exists,
# so a run never truncates a committed log (see testRunnerTools.ResolveLogFile).
# One shared directory, so it is trivial to delete (revision2026 step R3.8).
python/logs/tmp/

# build byproducts from setup.py
# compiler object files
tmp/
# the demos wrote a solution directory into the working directory until revision2026b step
# RG11.2 (#2620); an older installed version still does, and it must not be committed
solution/
# stdout redirect when quietCompile is set
setuppy.output.txt

# the '-local' copy that runTestSuite.py writes next to the models for CI artifact
# collection; the release copy in python/logs/testmodels/ is the one that is kept
python/TestModels/testSuiteLog_V*.txt
python/TestModels/testExamplesLog_V*.txt

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Experimental / internal-only work
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Listed BEFORE any such directory exists, on purpose: git does not recurse into a directory
# that holds its own .git, so an unignored nested repository is recorded by 'git add -A' as a
# GITLINK - a bare commit pointer with no content, which looks like a broken submodule to
# anyone cloning. Development-only Python material belongs in the second internal GitLab
# repository (revision2026 step R1.4), not here.
experimental/
Experimental/
/tmp

# Local working files, created from their committed templates by
# 'python tools/setupLocalWorkspace.py'. They are scratch space: the solution collects
# per-machine state, and python/pytest.py is where features are tried out in Visual Studio with
# mixed Python/C++ debugging. Keeping the working copies untracked means an experiment cannot be
# committed by accident - which used to rely on remembering to restore the default file first.
/exudyn.sln
/python/pytest.py
python/coordinatesSolution.txt
