# Exudyn .gitignore
#
# Deliberately NOT ignored, because they are versioned on purpose:
#   main/pythonDev/PerformanceLogs/   per-release performance records
#   main/pythonDev/TestSuiteLogs/     per-release test suite records (retention policy: plan D7)
#   main/pythonDev/TestExamplesLogs/  per-release example-run records
#   main/pythonDev/*/testData/*.npy   committed reference meshes
#   main/obj/cppsrc.vcxproj           the live VS project and de-facto source list
# Add new entries with a comment saying what produces the file.

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Visual Studio
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps
*.ilk
*.pdb
*.idb
*.tlog
*.iobj
*.ipdb
*.log
*.lastbuildstate
*.obj
*.exp
*.lib

# build configuration output directories (VS puts these next to the project)
x64/
Win32/
Debug/
Release/
ReleaseP*/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Python / setuptools build output
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
__pycache__/
*.py[cod]
*.so
*.pyd
build/
*.egg-info/
*.egg
.eggs/
wheelhouse/

# build output; untracked 2026-09-09 (plan step 1)
main/dist/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Generator scratch output
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# cached intermediate data written by pythonAutoGenerateSystemStructures.py
# and utilitiesDocuGenerator.py
main/src/pythonGenerator/generated/*.npy
# generator scratch file
test.txt

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Test suite output (written into the tree by runTestSuite.py)
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
main/pythonDev/TestModels/solution/
main/pythonDev/TestModels/coordinatesSolution.txt
main/pythonDev/Examples/solution/
main/pythonDev/Examples/coordinatesSolution.txt

# meshes regenerated by the netgen tests; the committed .npy reference files stay
main/pythonDev/TestModels/testData/netgenTestMesh*.hdf5
main/pythonDev/TestModels/testData/netgenTestMesh*.pkl
main/pythonDev/TestModels/testData/netgenTestMesh*.npz

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# LaTeX intermediates (theDoc.pdf itself is committed for now; see plan step 51)
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
*.aux
*.toc
*.out
*.synctex.gz
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.idx
*.ind
*.ilg

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Sphinx
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
_build/
docs/_build/
.doctrees/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Editors and OS
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
.idea/
.spyproject/
.ipynb_checkpoints/
Thumbs.db
desktop.ini
.DS_Store
