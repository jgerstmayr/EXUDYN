# Exudyn .gitignore
#
# Deliberately NOT ignored, because they are versioned on purpose:
#   python/PerformanceLogs/   per-release performance records
#   python/TestSuiteLogs/     per-release test suite records (retention policy: plan D7)
#   python/TestExamplesLogs/  per-release example-run records
#   python/*/testData/*.npy   committed reference meshes
#   msvc/cppsrc.vcxproj           the live VS project and de-facto source list
# Add new entries with a comment saying what produces the file.

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Visual Studio
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps
*.ilk
*.pdb
*.idb
*.tlog
*.iobj
*.ipdb
*.log
*.lastbuildstate
*.obj
*.exp
*.lib

# build configuration output directories (VS puts these next to the project)
x64/
Win32/
Debug/
Release/
ReleaseP*/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Python / setuptools build output
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
__pycache__/
*.py[cod]
*.so
*.pyd
build/
*.egg-info/
*.egg
.eggs/
wheelhouse/

# build output; untracked 2026-09-09 (plan step 1)
dist/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Generator scratch output
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# intermediate data formerly written by the generators (no longer written since step 33)
tools/generators/generated/*.npy
# generator scratch file
test.txt

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Test suite output (written into the tree by runTestSuite.py)
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
python/TestModels/solution/
python/TestModels/coordinatesSolution.txt
python/Examples/solution/
python/Examples/coordinatesSolution.txt

# meshes regenerated by the netgen tests; the committed .npy reference files stay
python/TestModels/testData/netgenTestMesh*.hdf5
python/TestModels/testData/netgenTestMesh*.pkl
python/TestModels/testData/netgenTestMesh*.npz

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# LaTeX intermediates (theDoc.pdf itself is committed for now; see plan step 51)
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
*.aux
*.toc
*.out
*.synctex.gz
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.idx
*.ind
*.ilg

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Sphinx
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
_build/
docs/_build/
.doctrees/

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Editors and OS
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
.idea/
.vscode/
.spyproject/
.ipynb_checkpoints/
Thumbs.db
desktop.ini
.DS_Store

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Regenerated on every issueTracker write; the same content is tracked as
# docs/RST/trackerlog.rst and docs/theDoc/trackerlog.tex
tools/issueTracker/trackerlog.html
tools/issueTracker/trackerlog_backup.txt

# diverted test/performance logs: written when the release-named target already exists,
# so a run never truncates a committed log (see testRunnerTools.ResolveLogFile).
# One shared directory, so it is trivial to delete. Becomes logs/tmp/ at plan step 74.
python/logsTmp/

# build byproducts from setup.py
# compiler object files
tmp/
# stdout redirect when quietCompile is set
setuppy.output.txt

# the '-local' copy that runTestSuite.py writes next to the models for CI artifact
# collection; the release copy in TestSuiteLogs/ is the one that is kept
python/TestModels/testSuiteLog_V*.txt
python/TestModels/testExamplesLog_V*.txt

#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Experimental / internal-only work
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Listed BEFORE any such directory exists, on purpose: git does not recurse into a directory
# that holds its own .git, so an unignored nested repository is recorded by 'git add -A' as a
# GITLINK - a bare commit pointer with no content, which looks like a broken submodule to
# anyone cloning. Development-only Python material belongs in the second internal GitLab
# repository (revision plan step 8), not here.
experimental/
Experimental/
/tmp

# Local working files, created from their committed templates by
# 'python tools/setupLocalWorkspace.py'. They are scratch space: the solution collects
# per-machine state, and python/pytest.py is where features are tried out in Visual Studio with
# mixed Python/C++ debugging. Keeping the working copies untracked means an experiment cannot be
# committed by accident - which used to rely on remembering to restore the default file first.
/exudyn.sln
/python/pytest.py
python/coordinatesSolution.txt
